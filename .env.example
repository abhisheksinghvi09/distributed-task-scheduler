POSTGRES_DB=taskscheduler
POSTGRES_USER=taskscheduler
POSTGRES_PASSWORD=change-me
POSTGRES_HOST=postgres
POSTGRES_PORT=5432

# NATS_URL defaults to nats://localhost:4222 if unset; in docker-compose it
# is set explicitly per-service to nats://nats:4222.
# NATS_URL=nats://nats:4222

TASK_LEASE_SECONDS=300
TASK_QUEUED_GRACE_SECONDS=60
ALLOW_SHELL_TASKS=0

# Optional: enables the llm_task and ai_triage task types on workers, and
# the AI-backed /v1/schedules/suggest-cron and /v1/tasks/search endpoints
# on the scheduler. Supports Google Gemini (preferred) or Anthropic Claude.
# GEMINI_API_KEY=your-gemini-api-key
# ANTHROPIC_API_KEY=sk-ant-...
